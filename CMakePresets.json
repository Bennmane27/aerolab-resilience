{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug (assertions on)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (benchmark reference build)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "Debug + AddressSanitizer (VNV-004)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AEROLAB_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "ubsan",
      "inherits": "base",
      "displayName": "Debug + UndefinedBehaviorSanitizer (VNV-005)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AEROLAB_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "Coverage (VNV-008)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AEROLAB_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "wasm",
      "inherits": "base",
      "displayName": "WebAssembly demo core (SYS-006)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AEROLAB_WASM": "ON",
        "AEROLAB_BUILD_TESTS": "OFF",
        "AEROLAB_BUILD_APPS": "OFF"
      }
    },
    {
      "name": "windows-msvc",
      "inherits": "base",
      "displayName": "Windows native (SYS-019, SHOULD)",
      "generator": "Visual Studio 17 2022",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    }
  ],
  "buildPresets": [
    { "name": "debug",    "configurePreset": "debug" },
    { "name": "release",  "configurePreset": "release" },
    { "name": "asan",     "configurePreset": "asan" },
    { "name": "ubsan",    "configurePreset": "ubsan" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "wasm",     "configurePreset": "wasm" }
  ],
  "testPresets": [
    { "name": "debug",    "configurePreset": "debug",    "output": { "outputOnFailure": true } },
    { "name": "release",  "configurePreset": "release",  "output": { "outputOnFailure": true } },
    { "name": "asan",     "configurePreset": "asan",     "output": { "outputOnFailure": true } },
    { "name": "ubsan",    "configurePreset": "ubsan",    "output": { "outputOnFailure": true } },
    { "name": "coverage", "configurePreset": "coverage", "output": { "outputOnFailure": true } }
  ]
}
